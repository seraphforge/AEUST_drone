---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="首頁"
  description="亞東科技大學無人機研究社 — 跨年級 × 跨領域 × 研究導向的無人機團隊。EST. 2026 · YEAR 01"
>

  <!-- =====================================================
       HERO
       ===================================================== -->
  <section class="hero">
    <div class="container">

      <p class="hero__overline">EST. 2026 &nbsp;·&nbsp; YEAR 01</p>

      <h1 class="hero__title">
        亞東科技大學<br />
        無人機研究社
      </h1>

      <p class="hero__sub">AEUST Drone Research Team</p>

      <p class="hero__tagline">
        跨年級 × 跨領域 × 研究導向
      </p>

      <div class="hero__actions">
        <a href="/projects" class="btn btn--primary">查看專題計畫</a>
        <a href="/about"    class="btn btn--outline">關於我們</a>
      </div>

    </div>
  </section>

  <!-- =====================================================
       ABOUT SNIPPET
       ===================================================== -->
  <section class="section-about">
    <div class="container">
      <div class="about-strip">

        <div class="about-strip__text">
          <span class="eyebrow">WHO WE ARE</span>
          <p class="about-strip__body">
            我們是亞東科技大學的無人機工程與研究團隊，由研究生與大學生共同組成。
            成員來自不同科系，以工程組別為核心協作單位，聚焦於飛行控制、自主系統與通訊技術的實作研究。
          </p>
          <a href="/about" class="about-strip__link">了解更多 →</a>
        </div>

        <div class="about-strip__marks" aria-hidden="true">
          <div class="identity-mark">
            <span class="identity-mark__value">2026</span>
            <span class="identity-mark__label">FOUNDED</span>
          </div>
          <div class="identity-mark">
            <span class="identity-mark__value">01</span>
            <span class="identity-mark__label">YEAR</span>
          </div>
          <div class="identity-mark">
            <span class="identity-mark__value">01</span>
            <span class="identity-mark__label">CYCLE</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =====================================================
       WHAT WE BUILD
       ===================================================== -->
  <section class="section-domains">
    <div class="container">

      <span class="eyebrow">WHAT WE BUILD</span>
      <h2 class="domains__title">六大工程方向</h2>

      <ul class="domains__grid" role="list">
        {[
          { id: 'FC',  zh: '飛行控制',   en: 'Flight & Control'        },
          { id: 'CS',  zh: '通訊系統',   en: 'Communication Systems'   },
          { id: 'ES',  zh: '嵌入式系統', en: 'Embedded Systems'        },
          { id: 'AS',  zh: '自主系統',   en: 'Autonomous Systems'      },
          { id: 'SIM', zh: '模擬',       en: 'Simulation'              },
          { id: 'DS',  zh: '無人機足球', en: 'Drone Soccer'            },
        ].map((d) => (
          <li class="domain-item">
            <span class="domain-item__id">{d.id}</span>
            <span class="domain-item__zh">{d.zh}</span>
            <span class="domain-item__en">{d.en}</span>
          </li>
        ))}
      </ul>

    </div>
  </section>

  <!-- =====================================================
       FEATURED PROJECTS
       ===================================================== -->
  <section class="section-projects">
    <div class="container">

      <div class="section-head">
        <span class="eyebrow">CYCLE 01 · PROJECTS</span>
        <h2 class="section-head__title">專題計畫</h2>
      </div>

      <!-- Empty state — no projects yet -->
      <div class="empty-state">
        <span class="empty-state__label">PROJECTS / DATA PENDING</span>
        <p class="empty-state__note">第一週期專題計畫建置中。</p>
        <a href="/projects" class="btn btn--ghost">查看所有計畫 →</a>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-block: var(--space-24) var(--space-20);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__overline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-family: var(--font-sans);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
  }

  .hero__sub {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .hero__tagline {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-10);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* ---- About strip ---- */
  .section-about {
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .about-strip {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    align-items: start;
  }

  .about-strip__body {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
    max-width: 56ch;
  }

  .about-strip__link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
    text-decoration: none;
  }

  .about-strip__link:hover { text-decoration: underline; }

  .about-strip__marks {
    display: flex;
    gap: var(--space-8);
    align-items: flex-start;
    flex-shrink: 0;
  }

  .identity-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .identity-mark__value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    line-height: 1;
  }

  .identity-mark__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
  }

  @media (max-width: 767px) {
    .about-strip {
      grid-template-columns: 1fr;
    }
    .about-strip__marks {
      gap: var(--space-6);
    }
  }

  /* ---- Domains ---- */
  .section-domains {
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .domains__title {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: var(--space-10);
    margin-top: var(--space-2);
  }

  .domains__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid var(--color-border);
    background-color: var(--color-border);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .domain-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background-color: var(--color-surface);
    transition: background-color var(--transition-fast);
  }

  .domain-item:hover {
    background-color: var(--color-accent-light);
  }

  .domain-item__id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
  }

  .domain-item__zh {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    line-height: 1.2;
  }

  .domain-item__en {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
  }

  @media (max-width: 767px) {
    .domains__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .domains__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Projects section ---- */
  .section-projects {
    padding-block: var(--space-16);
    background-color: var(--color-surface);
  }

  .section-head {
    margin-bottom: var(--space-10);
  }

  .section-head__title {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  /* ---- Empty state ---- */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-10) 0;
    border-top: 1px solid var(--color-border);
  }

  .empty-state__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
  }

  .empty-state__note {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
