---
import BaseLayout from '../layouts/BaseLayout.astro';

const engineeringGroups = [
  { id: 'LEAD', zh: '指揮核心',     en: 'Leadership'              },
  { id: 'FC',   zh: '飛行控制組',   en: 'Flight & Control'        },
  { id: 'CS',   zh: '通訊系統組',   en: 'Communication Systems'   },
  { id: 'ES',   zh: '嵌入式系統組', en: 'Embedded Systems'        },
  { id: 'AS',   zh: '自主系統組',   en: 'Autonomous Systems'      },
  { id: 'SIM',  zh: '模擬組',       en: 'Simulation'              },
  { id: 'DS',   zh: '無人機足球組', en: 'Drone Soccer'            },
];
---

<BaseLayout
  title="成員"
  description="AEUST Drone Research Team — 工程組別與創始成員。YEAR 01 · EST. 2026"
>

  <!-- Page header -->
  <div class="page-header">
    <div class="container">
      <p class="page-header__eyebrow">TEAM · YEAR 01</p>
      <h1 class="page-header__title">成員</h1>
      <p class="page-header__desc">
        跨年級 × 跨領域，以工程組別為協作核心。
      </p>
    </div>
  </div>

  <!-- =====================================================
       ENGINEERING GROUPS
       ===================================================== -->
  <section class="section border-bottom" style="background-color: var(--color-surface);">
    <div class="container">

      <span class="eyebrow">ENGINEERING GROUPS</span>
      <h2 class="section-title">工程組別</h2>

      <ul class="groups-list" role="list">
        {engineeringGroups.map((g) => (
          <li class="group-row">
            <span class="group-row__id">{g.id}</span>
            <span class="group-row__zh">{g.zh}</span>
            <span class="group-row__en">{g.en}</span>
          </li>
        ))}
      </ul>

    </div>
  </section>

  <!-- =====================================================
       MEMBERS
       ===================================================== -->
  <section class="section">
    <div class="container">

      <span class="eyebrow">ROSTER · YEAR 01</span>
      <h2 class="section-title">成員名單</h2>

      <!-- Empty state -->
      <div class="roster-empty">
        <p class="roster-empty__status">TEAM / ROSTER IN PREPARATION</p>
        <p class="roster-empty__note">
          創始成員資料建置中。成員資料確認後將於此處更新。
        </p>
      </div>

      <!-- Member cards will be rendered here once data exists.
           Structure reference for future population:

      <ul class="members-grid" role="list">
        <li class="member-card">
          <div class="member-card__photo-placeholder" aria-hidden="true"></div>
          <div class="member-card__info">
            <h3 class="member-card__name">[姓名]</h3>
            <p class="member-card__role">[角色]</p>
            <div class="member-card__badges">
              <span class="tag tag--year01">YEAR 01</span>
              [if foundingMember]: <span class="tag tag--founding">FOUNDING MEMBER</span>
            </div>
            <div class="member-card__groups">
              [group tags]
            </div>
          </div>
        </li>
      </ul>
      -->

    </div>
  </section>

</BaseLayout>

<style>
  .border-bottom { border-bottom: 1px solid var(--color-border); }

  /* ---- Page header ---- */
  .page-header {
    padding-block: var(--space-12) var(--space-8);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .page-header__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .page-header__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .page-header__desc {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    margin: 0;
    letter-spacing: var(--tracking-wide);
  }

  .section-title {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-top: var(--space-2);
    margin-bottom: var(--space-8);
  }

  /* ---- Groups list ---- */
  .groups-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .group-row {
    display: grid;
    grid-template-columns: 64px 1fr 1fr;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .group-row__id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
  }

  .group-row__zh {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
  }

  .group-row__en {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  @media (max-width: 639px) {
    .group-row {
      grid-template-columns: 48px 1fr;
    }
    .group-row__en { display: none; }
  }

  /* ---- Empty state ---- */
  .roster-empty {
    padding-block: var(--space-16);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .roster-empty__status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    margin: 0;
  }

  .roster-empty__note {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Future: members grid */
  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .member-card {
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .member-card__photo-placeholder {
    width: 100%;
    aspect-ratio: 1;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border-light);
  }

  .member-card__name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    margin: 0;
  }

  .member-card__role {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .member-card__badges,
  .member-card__groups {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
</style>
